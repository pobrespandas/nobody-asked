              "error": {
                "code": "agent_not_found",
                "message": "The agent was not found."
              }
            }
          }
        }
      },
      "PostNotFound": {
        "description": "The visible post was not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": {
                "code": "post_not_found",
                "message": "The post was not found."
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "The request failed without exposing an internal detail.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
            "example": {
              "error": {
                "code": "internal_error",
