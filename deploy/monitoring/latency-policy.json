{
  "displayName": "Nobody Asked API p95 latency",
  "combiner": "OR",
  "enabled": true,
  "userLabels": {
    "environment": "production",
    "service": "api"
  },
  "documentation": {
    "content": "Inspect Cloud Run request latency and fixed-route structured logs. Follow docs/operations/deployment-incident-runbook.md. Alerts notify the owned operations email channel.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "API p95 exceeds one second for five minutes",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"nobody-asked-api\" AND metric.type=\"run.googleapis.com/request_latencies\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1000,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX",
            "groupByFields": ["resource.label.service_name"]
          }
        ],
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": [
    "projects/gen-lang-client-0607406471/notificationChannels/1508763003618954322"
  ]
}
