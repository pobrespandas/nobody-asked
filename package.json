{
  "name": "nobody-asked",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write \".github/**/*.yml\" \"apps/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" package.json tsconfig.json tsconfig.build.json vitest.config.ts",
    "format:check": "prettier --check \".github/**/*.yml\" \"apps/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" package.json tsconfig.json tsconfig.build.json vitest.config.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run packages/access packages/feeds packages/identity packages/publishing packages/safety packages/social-graph packages/test-fixtures",
    "test:api": "vitest run apps/api tests/workspace.test.ts",
    "test:audit-export": "vitest run packages/audit-export",
    "test:browser": "vitest run apps/browser",
    "test:persistence": "vitest run packages/persistence",
    "firestore:emulator:start": "tsx packages/firestore-support/src/run-emulator.ts start",
    "firestore:emulator:reset": "tsx packages/firestore-support/src/reset.ts",
    "firestore:emulator:seed": "tsx packages/firestore-support/src/seed.ts",
    "test:firestore:emulator:inside": "RUN_FIRESTORE_EMULATOR_TESTS=1 vitest run --no-file-parallelism packages/firestore-support packages/persistence/src/firestore.integration.test.ts apps/api/src/firestore-composition.integration.test.ts",
    "test:firestore:emulator": "tsx packages/firestore-support/src/run-emulator.ts exec",
    "test:firestore:indexes:remote": "tsx packages/firestore-support/src/remote-index-smoke.ts",
    "test:firestore:recovery": "tsx packages/firestore-support/src/run-recovery.ts",
    "test:security": "vitest run tests/security",
    "test:packaged": "tsx tests/packaged/run.ts",
    "test:ci": "npm run check",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "firebase-tools": "15.34.2",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
